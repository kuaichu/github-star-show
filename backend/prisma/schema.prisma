generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id           Int           @id @default(autoincrement())
  name         String
  author       String
  category     String
  categorySource String      @default("rule")
  status       String
  language     String
  stars        Int
  updatedAt    String
  recommended  Boolean       @default(false)
  description  String
  features     String
  tags         String
  github       String        @unique
  demo         String
  docs         String
  note         String
  aiCategory   String?
  aiConfidence Float?
  aiReason     String?
  aiModel      String?
  aiClassifiedAt DateTime?
  latestReleaseAt DateTime?
  latestCommitAt DateTime?
  activityCheckedAt DateTime?
  publicVisible Boolean       @default(false)
  visibilityVerifiedAt DateTime?
  userProjects UserProject[]
}

model User {
  id             Int             @id @default(autoincrement())
  githubLogin    String?
  name           String?
  avatarUrl      String?
  profileUrl     String?
  lastStarSyncAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  githubAccount  GithubAccount?
  sessions       Session[]
  userProjects   UserProject[]
  syncRuns       SyncRun[]
  categories     ManagedCategory[]
  autoSyncConfig AutoSyncConfig?
}

model GithubAccount {
  id           Int      @id @default(autoincrement())
  githubUserId String   @unique
  login        String
  name         String?
  avatarUrl    String?
  profileUrl   String?
  accessToken  String
  scope        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  token     String   @id
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OAuthState {
  stateHash String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model UserProject {
  id           Int      @id @default(autoincrement())
  userId       Int
  projectId    Int
  category     String
  categorySource String  @default("manual")
  categoryReason String  @default("manual:legacy-data")
  status       String
  recommended  Boolean  @default(false)
  note         String
  demo         String
  docs         String
  tags         String
  features     String
  aiCategory   String?
  aiConfidence Float?
  aiReason     String?
  aiModel      String?
  aiClassifiedAt DateTime?
  source       String   @default("github_star")
  remoteStatus String   @default("active")
  remoteStatusNote String @default("")
  remoteCheckedAt DateTime?
  starredAt    DateTime?
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model SyncRun {
  id             Int       @id @default(autoincrement())
  userId         Int
  source         String
  status         String    @default("running")
  total          Int       @default(0)
  skippedPrivate Int       @default(0)
  errorCode      String?
  errorSummary   String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OperationLease {
  key           String    @id
  userId        Int
  kind          String
  owner         String    @default("")
  generation    Int       @default(0)
  expiresAt     DateTime?
  cooldownUntil DateTime?
  updatedAt     DateTime  @updatedAt

  @@index([userId, kind])
}

model ManagedCategory {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model AutoSyncConfig {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  enabled        Boolean   @default(false)
  mode           String    @default("incremental")
  intervalHours  Int       @default(24)
  nextScheduledAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
