# Relative file: URLs are resolved from prisma/schema.prisma; confirm the deployed absolute path before migration.
DATABASE_URL="file:./dev.db"
PORT=3000
CLIENT_ORIGIN="http://localhost:5173"
APP_BASE_URL="http://localhost:5173"
BACKEND_BASE_URL="http://localhost:3000"
GITHUB_TOKEN=""
GITHUB_API_BASE_URL="https://api.github.com"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Required to store GitHub OAuth tokens. Generate 32 random bytes and encode as base64.
GITHUB_TOKEN_ENCRYPTION_KEY=""
# Session cookie and database expiry use the same TTL. Defaults to 7 days.
SESSION_TTL_DAYS="7"
# Use lax for same-site deployments; use none only for a truly cross-site HTTPS frontend.
SESSION_COOKIE_SAME_SITE="lax"
# Secure defaults to true in production and false elsewhere. Uncomment only to force HTTPS cookies.
# SESSION_COOKIE_SECURE="true"
# Keep false unless the backend is behind these explicit proxy IPs/CIDRs. The value true is rejected.
TRUST_PROXY="false"
# Per-process login limiter; OAUTH_STATE_MAX_ACTIVE is the database-global hard cap for both active and total states.
OAUTH_LOGIN_RATE_LIMIT_MAX="10"
OAUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS="60"
OAUTH_LOGIN_RATE_LIMIT_MAX_CLIENTS="10000"
OAUTH_STATE_MAX_ACTIVE="10000"
OAUTH_STATE_CLEANUP_INTERVAL_SECONDS="30"
OAUTH_STATE_CLEANUP_BATCH="100"
# Shared outbound request policy. Retries apply only to safe idempotent requests.
HTTP_TIMEOUT_MS="10000"
HTTP_MAX_RETRIES="1"
HTTP_RETRY_BASE_MS="100"
ACTIVITY_FETCH_CONCURRENCY="2"
# Database-backed single-flight leases are renewed while work is active.
SYNC_LEASE_TTL_SECONDS="300"
SYNC_RUN_STALE_SECONDS="900"
AI_LEASE_TTL_SECONDS="600"
OPENAI_API_KEY=""
OPENAI_API_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
AI_CLASSIFICATION_ENABLED="false"
AI_CLASSIFICATION_MAX_PER_RUN="25"
AI_CLASSIFICATION_INCLUDE_README="false"
AI_CLASSIFICATION_COOLDOWN_SECONDS="300"
